# Translation destination is always explicit; never automatically fail over
# ollama = local, groq/gemini = cloud LLM, azure = cloud literal baseline
BRIDGE_TRANSLATOR=ollama

# Local private Ollama (start service and pull model separately)
OLLAMA_MODEL=qwen3:4b

# Groq model and API credential, only required if GROQ is selected
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Azure Translator is a context-free baseline; only required if selected
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Google Gemini remains optional; only required if selected
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional vetted predictor artifact; blank = conservative untrained context selection
# Only point to a trained artifact after independent held-out evaluation
BRIDGE_CONTEXT_MODEL=

# Optional supervised slang sense classifier; use only validated, locally trained weights
BRIDGE_SENSE_MODEL=

# Live local speech recognition + timeout
WHISPER_MODEL=base
AUDIO_CHUNK_SECONDS=4
# Floating caption overlay uses 92% opacity by default; adjust 82-100.
BRIDGE_OVERLAY_OPACITY=92
TRANSLATION_TIMEOUT_SECONDS=15
GEMINI_TIMEOUT_SECONDS=15
